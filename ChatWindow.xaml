<Window x:Class="ScreenSearchOverlay.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ChatGPT · Prompt Builder"
        Width="1000" Height="820"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#212121"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#333333" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#252526" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8,5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Back to the Prompt Builder, as it was left. -->
        <Border Background="#181818" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1">
            <Button Style="{StaticResource ToolbarButton}"
                    HorizontalAlignment="Left"
                    ToolTip="{DynamicResource chat.back.tip}"
                    Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,1,9,0" />
                    <TextBlock Text="{DynamicResource chat.back}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <!-- The page itself. WebView2 is an HWND: nothing WPF can be drawn
             over it, hence the bars in rows of their own. -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="1" />

        <!-- What the send is doing, and why it failed when it does. Hidden
             a moment after a successful send. -->
        <Border x:Name="StatusBar"
                Grid.Row="2"
                Background="#181818"
                BorderBrush="#2B2B2B"
                BorderThickness="0,1,0,0"
                Padding="14,8"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusGlyph"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="StatusText"
                           FontSize="12.5"
                           Foreground="#D4D4D4"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
