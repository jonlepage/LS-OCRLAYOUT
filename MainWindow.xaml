<Window x:Class="ScreenSearchOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Normal"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        Closed="Window_Closed">

    <Grid x:Name="RootGrid">
        <!-- Event catcher: near-invisible (1/255 alpha) but non-zero so the
             Raw Input Thread keeps delivering wheel events even when
             OverlayContent is hidden. -->
        <Rectangle Fill="#01000000" />

        <!-- Everything that should disappear while the user scrolls -->
        <Grid x:Name="OverlayContent">
            <!-- Screenshot as background -->
            <Image x:Name="ScreenshotImage" Stretch="Fill" />

            <!-- Semi-transparent dark overlay (hidden in translate mode so the
                 translated boxes blend with the real screen colors) -->
            <Rectangle x:Name="DimRect" Fill="#44000000" />

            <!-- Canvas for highlight rectangles -->
            <Canvas x:Name="HighlightCanvas" />

            <!-- Canvas for translated text boxes -->
            <Canvas x:Name="TranslationCanvas"
                    TextOptions.TextFormattingMode="Display" />
        </Grid>

        <!-- Search bar at top center -->
        <Border x:Name="SearchBarBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#EE1E1E1E"
                CornerRadius="8"
                Padding="12,8"
                MinWidth="400"
                MouseLeftButtonDown="SearchBar_MouseDown"
                MouseLeftButtonUp="SearchBar_MouseUp"
                MouseMove="SearchBar_MouseMove"
                Cursor="SizeAll">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="MenuButton"
                        Content="&#x2630;"
                        FontSize="16"
                        Width="28" Height="28"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Background="Transparent"
                        BorderBrush="#66FFFFFF"
                        Margin="0,0,8,0"
                        Click="MenuButton_Click"/>
                <TextBlock Text="&#x1F50D;"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox"
                         FontSize="18"
                         MinWidth="350"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="0"
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                         VerticalContentAlignment="Center"/>
                <ToggleButton x:Name="RegexToggle"
                              Content=".*"
                              FontSize="14"
                              FontFamily="Consolas"
                              Width="32" Height="28"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="White"
                              Background="Transparent"
                              BorderBrush="#66FFFFFF"
                              ToolTip="Regex search"
                              Checked="RegexToggle_Changed"
                              Unchecked="RegexToggle_Changed"/>
                <ToggleButton x:Name="TranslateToggle"
                              Content="文A"
                              FontSize="13"
                              Width="36" Height="28"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="White"
                              Background="Transparent"
                              BorderBrush="#66FFFFFF"
                              ToolTip="Translate screen"
                              Checked="TranslateToggle_Changed"
                              Unchecked="TranslateToggle_Changed"/>
            </StackPanel>
        </Border>

        <!-- Match count at bottom -->
        <TextBlock x:Name="BottomCountLabel"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,20"
                   Foreground="#AAffff00"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Text=""/>
    </Grid>
</Window>
