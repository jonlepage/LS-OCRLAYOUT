<Window x:Class="ScreenSearchOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Normal"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid">
        <!-- Screenshot as background -->
        <Image x:Name="ScreenshotImage" Stretch="Fill" />

        <!-- Semi-transparent dark overlay -->
        <Rectangle Fill="#44000000" />

        <!-- Canvas for highlight rectangles -->
        <Canvas x:Name="HighlightCanvas" />

        <!-- Search bar at top center -->
        <Border x:Name="SearchBarBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#EE1E1E1E"
                CornerRadius="8"
                Padding="12,8"
                MinWidth="400"
                MouseLeftButtonDown="SearchBar_MouseDown"
                MouseLeftButtonUp="SearchBar_MouseUp"
                MouseMove="SearchBar_MouseMove"
                Cursor="SizeAll">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="MenuButton"
                        Content="&#x2630;"
                        FontSize="16"
                        Width="28" Height="28"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Background="Transparent"
                        BorderBrush="#66FFFFFF"
                        Margin="0,0,8,0"
                        Click="MenuButton_Click"/>
                <TextBlock Text="&#x1F50D;"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox"
                         FontSize="18"
                         MinWidth="350"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="0"
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                         VerticalContentAlignment="Center"/>
                <ToggleButton x:Name="RegexToggle"
                              Content=".*"
                              FontSize="14"
                              FontFamily="Consolas"
                              Width="32" Height="28"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="White"
                              Background="Transparent"
                              BorderBrush="#66FFFFFF"
                              ToolTip="Regex search"
                              Checked="RegexToggle_Changed"
                              Unchecked="RegexToggle_Changed"/>
            </StackPanel>
        </Border>

        <!-- Match count at bottom -->
        <TextBlock x:Name="BottomCountLabel"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,20"
                   Foreground="#AAffff00"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Text=""/>
    </Grid>
</Window>
