<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The version lives in package.json only: read here at every build. -->
    <PackageJsonVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)package.json')), '"version"\s*:\s*"(\d+\.\d+\.\d+)"').Groups[1].Value)</PackageJsonVersion>
    <Version>$(PackageJsonVersion)</Version>
    <FileVersion>$(PackageJsonVersion).0</FileVersion>
    <AssemblyVersion>$(PackageJsonVersion).0</AssemblyVersion>
    <Product>ScreenSearchOverlay</Product>
    <Company>LEPASOFT</Company>
    <Description>OCR-powered screen text search overlay for Windows</Description>
    <Copyright>Copyright (c) 2026 Jon Lepage LEPASOFT</Copyright>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>