<Window x:Class="ScreenSearchOverlay.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenSearchOverlay"
        Title="Prompt Builder"
        Width="940" Height="620"
        MinWidth="720" MinHeight="470"
        WindowStyle="None"
        Background="{DynamicResource WindowBg}"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <!-- NOT AllowsTransparency: a layered window is read back from the GPU
         and copied whole to the OS on every frame, which made resizing crawl
         at 4K. This is a regular window; DWM draws the shadow (enabled by the
         1 px glass margin) and resizes it. Square corners everywhere, Windows
         11 included (see ConfigureNativeWindow). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Every visible string is a {DynamicResource key} published by Loc:
         a language change applies live. -->
    <Window.Resources>
        <!-- Colors come from Theme (application resources, dark or light):
             every brush is a DynamicResource, so a theme change applies live. -->
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <local:TitleBrushConverter x:Key="TitleBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ── Scrollbars: square, no arrows, a thumb that reads on the
             dark inputs ── -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="{DynamicResource ScrollThumb}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ScrollThumbDrag}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" MinHeight="24" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="MinHeight" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,3">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" MinWidth="24" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Text inputs. The placeholder is the Tag. ── -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource Placeholder}"
                                           Margin="{TemplateBinding Padding}"
                                           Padding="2,0,0,0"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Prompt name: reads as a title, shows it is editable on hover. -->
        <Style x:Key="TitleBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="4,3" />
        </Style>

        <!-- Search: the border belongs to the surrounding SearchField. -->
        <Style x:Key="BareTextBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,7" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SearchField" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderHover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Buttons ── -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBg}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="FontSize" Value="10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="11,8" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource LinkHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The title bar's "new version" pill. -->
        <!-- The title bar's tip link: a pink heart that catches the eye, the
             text quiet beside it, both brighter when hovered. -->
        <Style x:Key="QuietLink" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UpdatePill" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource PillBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PillBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource PillText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A row of the settings panel. -->
        <Style x:Key="MenuRowButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,7" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBg}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Title color swatch. Not focusable: clicking it keeps the focus,
             hence the edit mode, in the title box. Tag = "#RRGGBB" or "". -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="2" Background="Transparent">
                            <Border Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource StrongBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Splitters (sidebar width, prompt height) ── -->
        <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Line" Width="1" Fill="{DynamicResource Line}" HorizontalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowSplitter" TargetType="GridSplitter">
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Grip" Width="40" Height="3" Fill="{DynamicResource OuterBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Fill" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Fill" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Checkbox ── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- A label too long for its place (the settings panel in
                         Russian, Portuguese…) wraps instead of being cut; the
                         box stays level with its first line. -->
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="16" Height="16"
                                    BorderThickness="1.5"
                                    BorderBrush="{DynamicResource CheckBorder}"
                                    Background="Transparent"
                                    VerticalAlignment="Top"
                                    Margin="0,1,0,0">
                                <Path x:Name="Mark"
                                      Data="M 2.5,6.5 L 5.25,9.25 L 10.5,3.5"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square"
                                      StrokeLineJoin="Miter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Top">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StrongBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tooltips and context menu ── -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource PopupBg}"
                                BorderBrush="{DynamicResource PopupBorder}"
                                BorderThickness="1"
                                Padding="8,5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource PopupBg}"
                                BorderBrush="{DynamicResource PopupBorder}"
                                BorderThickness="1"
                                Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tag carries the icon glyph. -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,6,12,6" MinWidth="210">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="False" />
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="24,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource PopupBorder}" Margin="6,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Prompt list ── -->
        <!-- Virtualized and recycled (only visible rows exist, containers are
             reused), scrolled by pixel rather than by item. -->
        <Style x:Key="PromptListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False"
                                      CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The selection bar wears the prompt's title color. -->
        <Style x:Key="PromptItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="Bd" Background="Transparent" Padding="12,8,10,8">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                            <Border x:Name="Bar"
                                    Width="3"
                                    Background="{Binding TitleColor, Converter={StaticResource TitleBrush}, ConverterParameter=accent}"
                                    HorizontalAlignment="Left"
                                    Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PromptItemTemplate" DataType="{x:Type local:SavedPrompt}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Ctrl+1…9 keycap -->
                <Border x:Name="KeyCap"
                        Width="18" Height="18"
                        Background="{DynamicResource KeyCapBg}"
                        BorderBrush="{DynamicResource KeyCapBorder}"
                        BorderThickness="1"
                        Margin="0,1,10,0"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding Shortcut}"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{Binding TitleColor, Converter={StaticResource TitleBrush}}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PreviewText"
                               Text="{Binding Preview}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Shortcut}" Value="">
                    <Setter TargetName="KeyCap" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Preview}" Value="">
                    <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource OuterBorder}"
            BorderThickness="1"
            TextElement.Foreground="{DynamicResource TextPrimary}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Title bar (drag to move) ── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBg}"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8BD;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Prompt Builder"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="11,0,0,0" />
                    <!-- Support the app: a tip through Stripe. Gives its place
                         to the update pill when there is one. -->
                    <Button x:Name="TeaLink"
                            Grid.Column="2"
                            Style="{StaticResource QuietLink}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource pb.tea.tip}"
                            Click="TeaLink_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE00B;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Heart}"
                                       VerticalAlignment="Center"
                                       Margin="0,1,7,0" />
                            <TextBlock Text="{DynamicResource pb.tea}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- A newer version: one click downloads, installs and
                         restarts; the download's progress shows in it.
                         Filled by RefreshUpdateRow. -->
                    <Button x:Name="UpdateBanner"
                            Grid.Column="2"
                            Style="{StaticResource UpdatePill}"
                            Margin="16,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Click="Update_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="11"
                                       FontWeight="Normal"
                                       VerticalAlignment="Center"
                                       Margin="0,1,8,0" />
                            <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <!-- Straight to ChatGPT, nothing sent. -->
                    <Button Grid.Column="3"
                            Style="{StaticResource ChromeButton}"
                            Content="&#xE8F2;"
                            ToolTip="{DynamicResource pb.openChat}"
                            Click="OpenChat_Click" />
                    <Button x:Name="SettingsButton"
                            Grid.Column="4"
                            Style="{StaticResource ChromeButton}"
                            Content="&#xE713;"
                            ToolTip="{DynamicResource pb.settings}"
                            Click="SettingsButton_Click" />
                    <Button Grid.Column="5"
                            Style="{StaticResource CloseButton}"
                            Content="&#xE8BB;"
                            ToolTip="{DynamicResource pb.close}"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <!-- Settings panel. Outside the title bar so a click in it never
                 reaches the title bar's drag handler. -->
            <Popup x:Name="SettingsPopup"
                   Grid.Row="0"
                   PlacementTarget="{Binding ElementName=SettingsButton}"
                   Placement="Bottom"
                   HorizontalOffset="-250"
                   VerticalOffset="2"
                   StaysOpen="False"
                   PopupAnimation="None"
                   Closed="SettingsPopup_Closed">
                <Border Width="290"
                        Background="{DynamicResource PopupBg}"
                        BorderBrush="{DynamicResource PopupBorder}"
                        BorderThickness="1"
                        Padding="6,10"
                        TextElement.Foreground="{DynamicResource TextPrimary}"
                        TextElement.FontFamily="Segoe UI"
                        TextElement.FontSize="13">
                    <StackPanel>
                        <Button x:Name="LanguageMenu" Style="{StaticResource MenuRowButton}" Click="LanguageMenu_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE774;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentSoft}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource pb.settings.languageRow}" VerticalAlignment="Center" />
                                <TextBlock x:Name="LanguageValue" Grid.Column="2" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                <TextBlock Grid.Column="3"
                                           Text="&#xE76C;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <!-- Inside the settings panel, so a click in it doesn't
                             count as a click outside the panel. -->
                        <Popup x:Name="LanguagePopup"
                               PlacementTarget="{Binding ElementName=LanguageMenu}"
                               Placement="Left"
                               HorizontalOffset="-4"
                               VerticalOffset="-7"
                               StaysOpen="False"
                               PopupAnimation="None">
                            <Border MinWidth="190"
                                    Background="{DynamicResource PopupBg}"
                                    BorderBrush="{DynamicResource PopupBorder}"
                                    BorderThickness="1"
                                    Padding="6"
                                    TextElement.Foreground="{DynamicResource TextPrimary}"
                                    TextElement.FontFamily="Segoe UI"
                                    TextElement.FontSize="13">
                                <ItemsControl x:Name="LanguageRows">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:LanguageRow}">
                                                <Button Style="{StaticResource MenuRowButton}" Tag="{Binding Code}" Click="Language_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource AccentSoft}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                        <!-- Name on the left, its ISO code aligned on the right. -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Badge}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="16,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </Border>
                        </Popup>
                        <Button x:Name="ThemeMenu" Style="{StaticResource MenuRowButton}" Click="ThemeMenu_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE790;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentSoft}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource pb.settings.themeRow}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ThemeValue" Grid.Column="2" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                <TextBlock Grid.Column="3"
                                           Text="&#xE76C;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <!-- Inside the settings panel, so a click in it doesn't
                             count as a click outside the panel. -->
                        <Popup x:Name="ThemePopup"
                               PlacementTarget="{Binding ElementName=ThemeMenu}"
                               Placement="Left"
                               HorizontalOffset="-4"
                               VerticalOffset="-7"
                               StaysOpen="False"
                               PopupAnimation="None">
                            <Border MinWidth="190"
                                    Background="{DynamicResource PopupBg}"
                                    BorderBrush="{DynamicResource PopupBorder}"
                                    BorderThickness="1"
                                    Padding="6"
                                    TextElement.Foreground="{DynamicResource TextPrimary}"
                                    TextElement.FontFamily="Segoe UI"
                                    TextElement.FontSize="13">
                                <ItemsControl x:Name="ThemeRows">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:LanguageRow}">
                                                <Button Style="{StaticResource MenuRowButton}" Tag="{Binding Code}" Click="Theme_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource AccentSoft}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </Border>
                        </Popup>

                        <Border Height="1" Background="{DynamicResource PopupBorder}" Margin="2,10" />

                        <TextBlock Text="{DynamicResource pb.settings.chatgpt}" Style="{StaticResource SectionLabel}" Margin="8,0,8,8" />
                        <CheckBox x:Name="TemporaryChatOption"
                                  Margin="8,0,8,0"
                                  Content="{DynamicResource pb.settings.temporary}"
                                  ToolTip="{DynamicResource pb.settings.temporary.tip}"
                                  Checked="Option_Changed"
                                  Unchecked="Option_Changed" />
                        <CheckBox x:Name="AutoSendTextOption"
                                  Margin="8,10,8,0"
                                  Content="{DynamicResource pb.settings.autoSendText}"
                                  ToolTip="{DynamicResource pb.settings.autoSendText.tip}"
                                  Checked="Option_Changed"
                                  Unchecked="Option_Changed" />
                        <CheckBox x:Name="AutoSendImageOption"
                                  Margin="8,10,8,0"
                                  Content="{DynamicResource pb.settings.autoSendImage}"
                                  ToolTip="{DynamicResource pb.settings.autoSendImage.tip}"
                                  Checked="Option_Changed"
                                  Unchecked="Option_Changed" />
                        <CheckBox x:Name="ClipboardImageOption"
                                  Margin="8,10,8,0"
                                  Content="{DynamicResource pb.settings.clipboardImage}"
                                  ToolTip="{DynamicResource pb.settings.clipboardImage.tip}"
                                  Checked="Option_Changed"
                                  Unchecked="Option_Changed" />

                        <Border Height="1" Background="{DynamicResource PopupBorder}" Margin="2,10" />

                        <TextBlock Text="{DynamicResource pb.settings.textSize}" Style="{StaticResource SectionLabel}" Margin="8,0,8,6" />
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                            <Button Style="{StaticResource IconButton}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    Content="&#xE738;"
                                    Click="TextSmaller_Click" />
                            <TextBlock x:Name="TextSizeValue"
                                       Width="48"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButton}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    Content="&#xE710;"
                                    Click="TextLarger_Click" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource pb.settings.textSizeHint}" Style="{StaticResource Hint}" Margin="8,8,8,0" />

                        <Border Height="1" Background="{DynamicResource PopupBorder}" Margin="2,10" />

                        <TextBlock Text="{DynamicResource pb.settings.account}" Style="{StaticResource SectionLabel}" Margin="8,0,8,6" />
                        <Button Style="{StaticResource MenuRowButton}"
                                ToolTip="{DynamicResource pb.settings.newAccount.tip}"
                                Click="NewAccount_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE910;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentSoft}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource pb.settings.newAccount}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="&#xE8A7;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Height="1" Background="{DynamicResource PopupBorder}" Margin="2,10" />

                        <TextBlock Text="{DynamicResource pb.settings.agents}" Style="{StaticResource SectionLabel}" Margin="8,0,8,8" />
                        <CheckBox x:Name="McpOption"
                                  Margin="8,0,8,0"
                                  Content="{DynamicResource pb.settings.mcp}"
                                  ToolTip="{DynamicResource pb.settings.mcp.tip}"
                                  Checked="McpOption_Changed"
                                  Unchecked="McpOption_Changed" />
                        <Button Style="{StaticResource MenuRowButton}" Margin="0,6,0,0" Click="McpHelp_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE943;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentSoft}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource pb.settings.mcpHelp}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Height="1" Background="{DynamicResource PopupBorder}" Margin="2,10" />

                        <!-- Filled by RefreshUpdateRow, from the app-wide update state. -->
                        <TextBlock Text="{DynamicResource pb.settings.updates}" Style="{StaticResource SectionLabel}" Margin="8,0,8,6" />
                        <TextBlock x:Name="UpdateStatus"
                                   Style="{StaticResource Hint}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="8,0,8,4" />
                        <Button x:Name="UpdateButton"
                                Style="{StaticResource MenuRowButton}"
                                Click="Update_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpdateIcon"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentSoft}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="UpdateButtonText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}"
                                ToolTip="{DynamicResource pb.settings.changelog.tip}"
                                Click="Changelog_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentSoft}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource pb.settings.changelog}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="&#xE8A7;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <CheckBox x:Name="AutoUpdateOption"
                                  Margin="8,8,8,2"
                                  Content="{DynamicResource pb.settings.autoUpdate}"
                                  Checked="Option_Changed"
                                  Unchecked="Option_Changed" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ── Body ── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="290" MinWidth="200" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- Left: saved prompts -->
                <Grid Grid.Column="0" Background="{DynamicResource SidebarBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource SearchField}" Margin="12,12,12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Style="{StaticResource BareTextBox}"
                                     Tag="{DynamicResource pb.search}"
                                     TextChanged="SearchBox_TextChanged" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="PromptList"
                             Grid.Row="1"
                             Margin="6,0,4,0"
                             Style="{StaticResource PromptListStyle}"
                             ItemContainerStyle="{StaticResource PromptItemStyle}"
                             ItemTemplate="{StaticResource PromptItemTemplate}"
                             SelectionChanged="PromptList_SelectionChanged"
                             MouseDoubleClick="PromptList_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkMenu}" ItemContainerStyle="{StaticResource DarkMenuItem}">
                                <MenuItem Header="{DynamicResource pb.menu.send}" Tag="&#xE724;" InputGestureText="{DynamicResource pb.key.enter}" Click="Send_Click" />
                                <Separator Style="{StaticResource DarkMenuSeparator}" />
                                <MenuItem Header="{DynamicResource pb.menu.up}" Tag="&#xE74A;" InputGestureText="Alt+↑" Click="MoveUp_Click" />
                                <MenuItem Header="{DynamicResource pb.menu.down}" Tag="&#xE74B;" InputGestureText="Alt+↓" Click="MoveDown_Click" />
                                <MenuItem Header="{DynamicResource pb.menu.duplicate}" Tag="&#xE8C8;" InputGestureText="Ctrl+D" Click="Duplicate_Click" />
                                <Separator Style="{StaticResource DarkMenuSeparator}" />
                                <MenuItem Header="{DynamicResource pb.menu.delete}" Tag="&#xE74D;" InputGestureText="{DynamicResource pb.key.delete}" Click="Delete_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <StackPanel x:Name="EmptyList"
                                Grid.Row="1"
                                Margin="20,28,20,0"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                        <TextBlock x:Name="EmptyListText"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" />
                        <Button x:Name="CreateFromSearchButton"
                                Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0"
                                Click="CreateFromSearch_Click" />
                    </StackPanel>

                    <Button Grid.Row="2"
                            Style="{StaticResource OutlineButton}"
                            Margin="12,8,12,12"
                            ToolTip="{DynamicResource pb.new.tip}"
                            Click="NewPrompt_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,9,0" />
                                <TextBlock Text="{DynamicResource pb.new}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Ctrl+N" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                        </Grid>
                    </Button>
                </Grid>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource ColumnSplitter}"
                              ToolTip="{DynamicResource pb.tip.splitter}"
                              DragCompleted="Splitter_DragCompleted" />

                <!-- Right: the selected prompt (editable in place) and the text -->
                <Grid x:Name="Editor"
                      Grid.Column="2"
                      Margin="22,14,22,16"
                      DataContext="{Binding SelectedItem, ElementName=PromptList}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="PromptRow" Height="96" MinHeight="48" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{DynamicResource pb.section.prompt}" Style="{StaticResource SectionLabel}" />
                        <StackPanel x:Name="PromptActions" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="{DynamicResource pb.tip.up}" Click="MoveUp_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74B;" ToolTip="{DynamicResource pb.tip.down}" Click="MoveDown_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="{DynamicResource pb.tip.duplicate}" Click="Duplicate_Click" />
                            <Button Style="{StaticResource DangerIconButton}" Content="&#xE74D;" ToolTip="{DynamicResource pb.tip.delete}" Click="Delete_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Title, and its color palette while it is being edited -->
                    <Grid Grid.Row="1" Margin="-5,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox"
                                 Style="{StaticResource TitleBox}"
                                 Tag="{DynamicResource pb.name.placeholder}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="{Binding TitleColor, Converter={StaticResource TitleBrush}}" />
                        <StackPanel x:Name="TitlePalette"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"
                                    Visibility="{Binding IsKeyboardFocused, ElementName=NameBox, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <TextBox x:Name="PromptBox"
                             Grid.Row="2"
                             Style="{StaticResource InputBox}"
                             Tag="{DynamicResource pb.prompt.placeholder}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             PreviewMouseWheel="TextArea_PreviewMouseWheel"
                             Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" />

                    <GridSplitter Grid.Row="3"
                                  Style="{StaticResource RowSplitter}"
                                  ToolTip="{DynamicResource pb.tip.splitter}"
                                  DragCompleted="Splitter_DragCompleted" />

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource pb.section.text}" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="CharCount" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBox x:Name="BodyBox"
                                 Grid.Row="1"
                                 Style="{StaticResource InputBox}"
                                 Tag="{DynamicResource pb.text.placeholder}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewMouseWheel="TextArea_PreviewMouseWheel"
                                 TextChanged="BodyBox_TextChanged" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- ── Footer: capture, hints, total, send ── -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ChromeBg}"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Tracks the hint column's width, which also changes
                         when the total beside it grows. -->
                    <Border x:Name="HintHost" Grid.Column="1" SizeChanged="HintHost_SizeChanged" />

                    <StackPanel x:Name="CapturePanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CaptureThumb"
                                Width="72" Height="42"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1"
                                Cursor="Hand"
                                ToolTipService.InitialShowDelay="150"
                                MouseLeftButtonUp="CaptureThumb_MouseLeftButtonUp" />
                        <CheckBox x:Name="AttachCapture"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="{DynamicResource pb.capture}"
                                  Checked="AttachCapture_Changed"
                                  Unchecked="AttachCapture_Changed" />
                    </StackPanel>

                    <!-- Shown whole or not at all (FitHint): never cut by an ellipsis. -->
                    <TextBlock x:Name="HintText"
                               Grid.Column="1"
                               Margin="16,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Hint}">
                        <Run Text="{DynamicResource pb.hint.sendKey}" Foreground="{DynamicResource TextSecondary}" /><Run Text="{DynamicResource pb.hint.send}" /><Run Text="↑↓" Foreground="{DynamicResource TextSecondary}" /><Run Text="{DynamicResource pb.hint.pick}" /><Run Text="{DynamicResource pb.hint.escKey}" Foreground="{DynamicResource TextSecondary}" /><Run Text="{DynamicResource pb.hint.close}" />
                    </TextBlock>

                    <StackPanel x:Name="UndoPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="UndoText" Style="{StaticResource Hint}" Foreground="{DynamicResource TextSecondary}" />
                        <Button Style="{StaticResource LinkButton}" Content="{DynamicResource pb.undo}" Margin="6,0,0,0" Click="Undo_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- What ChatGPT will receive: prompt + blank line + text -->
                        <TextBlock x:Name="TotalCount" Style="{StaticResource Hint}" Margin="0,0,14,0" />
                        <Button x:Name="SendButton"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="{DynamicResource pb.send.tip}"
                                Click="Send_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource pb.send}" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE724;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center"
                                           Margin="10,1,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── MCP setup dialog (RefreshMcpDialog fills it) ── -->
            <Border x:Name="McpDialog"
                    Grid.RowSpan="3"
                    Background="#99000000"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="McpDialogBackdrop_MouseLeftButtonDown">
                <Border Width="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PopupBg}"
                        BorderBrush="{DynamicResource PopupBorder}"
                        BorderThickness="1"
                        MouseLeftButtonDown="McpDialogCard_MouseLeftButtonDown">
                    <StackPanel>
                        <Grid Background="{DynamicResource ChromeBg}">
                            <TextBlock Text="{DynamicResource mcp.title}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="12,0" />
                            <Button Style="{StaticResource CloseButton}"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    Content="&#xE8BB;"
                                    ToolTip="{DynamicResource mcp.close}"
                                    Click="McpDialogClose_Click" />
                        </Grid>
                        <StackPanel Margin="12,10,12,12">
                            <TextBlock x:Name="McpStatus" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{DynamicResource mcp.intro}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                            <TextBlock Text="{DynamicResource mcp.claudeCode}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="McpCommand"
                                         Style="{StaticResource InputBox}"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="6,5"
                                         IsReadOnly="True" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButton}"
                                        BorderBrush="{DynamicResource InputBorder}"
                                        Height="Auto"
                                        Margin="4,0,0,0"
                                        Content="&#xE8C8;"
                                        ToolTip="{DynamicResource mcp.copy}"
                                        Tag="{Binding Text, ElementName=McpCommand}"
                                        Click="McpCopy_Click" />
                            </Grid>

                            <TextBlock Text="{DynamicResource mcp.json}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="McpJson"
                                         Style="{StaticResource InputBox}"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="6,5"
                                         IsReadOnly="True"
                                         AcceptsReturn="True" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButton}"
                                        BorderBrush="{DynamicResource InputBorder}"
                                        Height="Auto"
                                        VerticalAlignment="Stretch"
                                        Margin="4,0,0,0"
                                        Content="&#xE8C8;"
                                        ToolTip="{DynamicResource mcp.copy}"
                                        Tag="{Binding Text, ElementName=McpJson}"
                                        Click="McpCopy_Click" />
                            </Grid>

                            <TextBlock Text="{DynamicResource mcp.note}" TextWrapping="Wrap" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
